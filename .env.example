# ProofHire Environment Variables Configuration
# Copy this file to .env in the root proofHire/ folder:
# Windows (cmd): copy .env.example .env
# Windows (PowerShell): cp .env.example .env
# Mac/Linux: cp .env.example .env

# 1. Google Gemini API Key (Required for live LLM generation)
# Obtain your free API key at: https://aistudio.google.com/app/apikey
# NOTE: If left blank or omitted, ProofHire automatically runs in offline mode 
# using pre-warmed, deterministic senior engineering models with zero downtime!
GEMINI_API_KEY=your_gemini_api_key_here

# 2. GitHub OAuth Integration (Optional - for importing candidate public repositories)
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here

# 3. Platform Configuration
PUBLIC_USE_MOCKS=false
